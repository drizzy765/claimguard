# Copy to .env and fill in. NEVER commit .env.

# API auth (required for /audit, /run, /supervisor, /upload)
FACTORY_MASTER_KEY=change_me_to_a_long_random_string

# =============================================================================
# 1) PRIMARY — Gemini API + Gemma 4 (first choice)
#    https://aistudio.google.com/apikey
# =============================================================================
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemma-4-31b-it

# =============================================================================
# 2) FALLBACK — Groq (used automatically if Gemini fails / out of credits)
#    https://console.groq.com/keys
# =============================================================================
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# =============================================================================
# 3) OPTIONAL — self-hosted Ollama/vLLM (tried between Gemini and Groq if set)
# =============================================================================
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=ollama
LLM_FALLBACK_MODEL=gemma4:12b

# Optional extras
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

ENVIRONMENT=development
