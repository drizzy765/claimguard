# Copy to .env and fill in. NEVER commit .env.

# API auth (required for /audit, /run, /supervisor, /upload)
FACTORY_MASTER_KEY=change_me_to_a_long_random_string

# Primary LLM — Gemini API Gemma 4 (recommended for demo)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemma-4-26b-a4b-it

# Optional fallback — self-hosted Ollama / vLLM (open weights)
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=ollama
LLM_FALLBACK_MODEL=gemma4:12b

# Optional legacy providers (only used if LLM_API_KEY is empty; model names via env)
GROQ_API_KEY=
GROQ_MODEL=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Environment
ENVIRONMENT=development
