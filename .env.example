# Copy to .env and fill in. NEVER commit .env.

# API auth (required for /audit, /run, /supervisor, /upload)
FACTORY_MASTER_KEY=change_me_to_a_long_random_string

# ---------------------------------------------------------------------------
# Primary LLM — Gemini API Gemma 4 (demo default)
# ---------------------------------------------------------------------------
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemma-4-26b-a4b-it

# ---------------------------------------------------------------------------
# Groq — AUTOMATIC fallback when Gemini is out of credits / rate-limits / down
# Chain: Gemini → (optional Ollama) → Groq
# Get a key at https://console.groq.com/keys
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---------------------------------------------------------------------------
# Optional self-hosted Ollama / vLLM (tried BEFORE Groq if set)
# ---------------------------------------------------------------------------
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=ollama
LLM_FALLBACK_MODEL=gemma4:12b

# Optional extra providers (only if keys + model names are set)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Environment
ENVIRONMENT=development
